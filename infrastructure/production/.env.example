# Server settings for infrastructure/production/docker-compose.yml (Phases 86–87).
# On the server this file is /opt/garnishtable/config/edge.env (mode 600 — REDIS_PASSWORD and
# ALERT_WEBHOOK_URL below are secrets). Never commit a filled-in copy. API secrets (MONGO_URI,
# JWT_*, …) go in the API env file named by GT_API_ENV_FILE, never here.
# See docs/production-deployment-runbook.md.

# --- The seven GarnishTable hostnames (docs/production-architecture.md) ----------------------------
MARKETING_HOST=garnishtable.com
APP_HOST=app.garnishtable.com
AGENCY_HOST=agency.garnishtable.com
ADMIN_HOST=admin.garnishtable.com
POS_HOST=pos.garnishtable.com
ORDER_HOST=order.garnishtable.com
API_HOST=api.garnishtable.com

# --- Restaurant custom domains -----------------------------------------------------------------------
# The hostname restaurants point their domain at (CNAME). It needs an A/AAAA record to this server.
# Also passed to the API, which shows it to restaurants in the domain settings panel.
CUSTOM_DOMAIN_CNAME_TARGET=domains.garnishtable.com
# Private port of the API's certificate-issuance check. Never published.
CUSTOM_DOMAIN_TLS_ASK_PORT=4001

# --- Certificates ------------------------------------------------------------------------------------
# Contact address registered with the certificate authority (expiry/problem notices).
ACME_EMAIL=
# Let's Encrypt production. For a rehearsal use the staging CA so you don't burn production limits:
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CADDY_RENEW_INTERVAL=10m

# --- Host / images -----------------------------------------------------------------------------------
# Private edge network (Caddy + frontends + API). The API trusts X-Forwarded-For only from here.
GT_EDGE_SUBNET=172.30.86.0/24
GT_CADDY_IP=172.30.86.10
# Where CI publishes the images (lowercase). The tag is never set here: deploy.sh pins it per
# deployment (sha-<commit>), so this file can't silently move production to a different build.
GT_IMAGE_REGISTRY=ghcr.io/chaudhryzain666/restaurant-os
# Absolute path of the API secrets file (mode 600). Template: apps/api/.env.production.example
GT_API_ENV_FILE=/opt/garnishtable/config/api.env

# --- Redis -------------------------------------------------------------------------------------------
# "local-redis" runs Redis 7 on this server (private network, AOF persistence, noeviction). Leave
# empty when REDIS_URL in the API env file points at a managed Redis instead.
GT_COMPOSE_PROFILES=local-redis
# Required with local-redis; use a long random value (openssl rand -hex 32). The API's REDIS_URL is
# then redis://:<this value>@redis:6379
REDIS_PASSWORD=

# --- Operations ----------------------------------------------------------------------------------------
# Alerts from deploy.sh, healthwatch.sh and backup.sh: any URL accepting a JSON POST with a "text"
# or "content" field (Slack / Discord incoming webhook, ntfy, …). Empty = log only.
ALERT_WEBHOOK_URL=
# Keep local MongoDB dumps this many days.
GT_BACKUP_KEEP_DAYS=14
# Command that copies each dump off this server (the file path is appended), e.g.
#   rclone copy --quiet --config /opt/garnishtable/config/rclone.conf <remote>:garnishtable-backups
GT_BACKUP_OFFSITE_CMD=
