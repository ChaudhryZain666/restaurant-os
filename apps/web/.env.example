VITE_RESTAURANT_SLUG=demo-restaurant
# Absolute API origin for the Socket.IO client — REST calls go through Vite's /api proxy (see
# vite.config.ts), but the socket connects directly since it isn't proxied.
VITE_API_URL=http://localhost:4000
# Cross-origin CTA targets for the public storefront-playground demo (Phase 32) — the same
# cross-origin link pattern apps/marketing already uses for its own admin/storefront links.
VITE_ADMIN_URL=http://localhost:5174
VITE_MARKETING_URL=http://localhost:5175
