NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/restaurant_platform
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# The marketing site's own origin (apps/marketing) — CORS is built directly from this in
# production, so a real deployment must set it to the real deployed marketing-site URL or the
# marketing site's own API calls (e.g. its live pricing page) will be silently rejected.
MARKETING_ORIGIN=http://localhost:5175
# The API's own publicly-reachable origin — only used to build an absolute URL shown TO a user for
# pasting elsewhere (currently just the BYOC webhook URL a restaurant pastes into its own Stripe/
# Safepay dashboard). Not a CORS origin.
API_PUBLIC_ORIGIN=http://localhost:4000

# Login/register/reset/invite throttle (30/15min/IP) — leave this at 30 for dev and production.
# Only raise it here, locally, if you're about to run the FULL Playwright suite against this dev
# server: every spec logs in at least once, all from this one machine's IP, so a full run's
# aggregate traffic can exceed 30 within 15 minutes even though no real client ever would. Never
# raise this in a real deployment.
AUTH_RATE_LIMIT_MAX=30

# Global "foundation-level" throttle (1000/15min/IP, every route) — leave this at 1000 for dev and
# production. Only raise it here, locally, for the same reason as AUTH_RATE_LIMIT_MAX above: a full
# local Playwright run's aggregate request volume across every route easily exceeds 1000 within 15
# minutes. Never raise this in a real deployment.
GLOBAL_RATE_LIMIT_MAX=1000

# File storage (optional for Phase 0 — leave blank until a real bucket exists).
# Works with AWS S3 directly, or any S3-compatible provider (Cloudflare R2, MinIO)
# by setting STORAGE_ENDPOINT.
# Phase 81 — outside production, leaving these blank now falls back to a real (not mocked)
# local-disk storage adapter (apps/api/.local-storage/, served at /local-storage) instead of
# throwing, so file-upload features are genuinely testable without a cloud storage account.
# Production always requires real credentials here and never falls back.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# Geocoding/address autocomplete (optional — leave GEOCODING_PROVIDER unset and the feature fails
# gracefully with a clear "not configured" error; the app still boots normally either way).
#   GEOCODING_PROVIDER=locationiq   real provider (see docs/delivery-architecture.md) — requires
#                                    GEOCODING_API_KEY from https://locationiq.com
#   GEOCODING_PROVIDER=test         deterministic, offline adapter — no key needed, safe for local
#                                    dev/CI (this is what this repo's own test suites use)
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
GEOCODING_BASE_URL=

# Email (optional in development/test — leave EMAIL_PROVIDER unset/"console" and verification/
# reset/invite/order/trial emails are logged to the server console instead of sent, which is what
# this repo's own dev/test flows rely on). NODE_ENV=production REQUIRES EMAIL_PROVIDER=smtp with
# SMTP_HOST/PORT and EMAIL_FROM all set — the app now refuses to start otherwise (see config/env.ts)
# rather than silently running a real deployment's signup/reset/invite emails through the console.
#   EMAIL_PROVIDER=smtp   real provider (Nodemailer over SMTP) — requires SMTP_HOST/PORT and
#                         EMAIL_FROM to all be set.
# EMAIL_FROM must be a real, deliverable address on a domain you actually control — never a
# placeholder like the .local addresses this repo's seed/fixture data uses.
EMAIL_PROVIDER=console
EMAIL_FROM=
# Phase 56 — where the marketing site's Contact page / "Request a guided demo" lead form lands.
# Has a real default (unlike EMAIL_FROM) since it's a best-effort internal notification, not a
# customer-facing send.
CONTACT_NOTIFICATION_EMAIL=hello@garnishtable.local
# Real anti-spam default for the public contact endpoint — same local-dev/test escape hatch as
# AUTH_RATE_LIMIT_MAX/GLOBAL_RATE_LIMIT_MAX above, never touch in production.
CONTACT_RATE_LIMIT_MAX=5
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Payments (PAYMENT_PROVIDER=mock is the safe default — no real money ever moves; see
# apps/api/src/payments/MockPaymentProvider.ts). PAYMENT_PROVIDER=safepay/stripe are real,
# network-capable code (apps/api/src/payments/SafepayProvider.ts, StripeProvider.ts) but neither
# has ever been run against a live account — see those files and docs/payment-provider-decision.md
# before enabling either anywhere real money could move. This env var is only the single DEFAULT
# provider; PAYMENT_ELIGIBILITY_ROUTING=true additionally lets different restaurants route to
# different configured providers by country (apps/api/src/payments/eligibility.ts).
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=mock-payment-webhook-secret-dev-only
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The one centralized Stripe Connect webhook endpoint (events for every restaurant's own connected
# account, distinguished by event.account) — deliberately a separate secret from
# STRIPE_WEBHOOK_SECRET above, which only covers the pooled platform-account path.
STRIPE_CONNECT_WEBHOOK_SECRET=
PAYMENT_ELIGIBILITY_ROUTING=false
# Restaurant-owned payment accounts (BYOC): the AES-256-GCM key used to encrypt a restaurant's own
# pasted-in provider secret keys at rest. Must be a base64-encoded 32-byte key. Only needed if any
# restaurant uses BYOC. Rotating this without a migration permanently bricks every already-stored
# BYOC credential — there is no rotation tooling yet.
CREDENTIAL_ENCRYPTION_KEY=

# Marketplace order-ingestion (Uber Eats/DoorDash/foodpanda). NOT BYOC — all three authenticate
# GarnishTable itself as one registered partner app for the whole deployment; the per-restaurant
# piece is just an externalStoreId stored on the integration document. Every value below is
# optional — leaving them unset leaves the marketplace foundation fully architecturally in place
# but unable to make a real network call, which each adapter reports honestly rather than faking a
# connection. See docs/marketplace-integration-architecture.md.
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SECRET=
# DoorDash's signing key is only issued after a Technical-Account-Manager-assisted certification
# process — see developer.doordash.com's Marketplace onboarding guide.
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
FOODPANDA_CLIENT_ID=
FOODPANDA_CLIENT_SECRET=
FOODPANDA_CHAIN_ID=
FOODPANDA_WEBHOOK_TOKEN=

# Phase 81 — menu-import extraction (PDF/URL/image sources). "mock" (default) makes the whole
# async import pipeline exercisable with zero real credentials — see
# apps/api/src/menuExtraction/MockMenuExtractionProvider.ts. "live" targets Anthropic's real Claude
# Messages API (apps/api/src/menuExtraction/ClaudeMenuExtractionProvider.ts) — real, network-capable
# code, never exercised against a live API key in this environment. Selecting "live" without
# ANTHROPIC_API_KEY throws clearly rather than silently falling back to mock.
MENU_EXTRACTION_PROVIDER_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# DNS verification for custom domains — "mock" (dev/test default) reads from a Mongo-seeded fake
# record; "node" performs real DNS TXT lookups and is the only provider that should ever be
# selected in production.
DNS_VERIFIER=mock

# Phase 74 — the physical POS card-terminal boundary, a different concern from PAYMENT_PROVIDER
# above (in-person hardware, not online checkout). Defaults to "none": every deployment shows the
# POS's honest Phase 73 staff-confirmation card flow unless this is explicitly set. "mock"
# (apps/api/src/payments/terminal/MockTerminalProvider.ts) is deterministic and test/dev-only — no
# real provider is implemented yet, see docs/payment-provider-decision.md's Phase 74 section for
# what one would require.
POS_TERMINAL_PROVIDER=none

# SaaS billing — a different financial domain from the restaurant payments above (owners/agencies
# paying the platform, not customers paying a restaurant). BILLING_PROVIDER=mock is the safe
# default. BILLING_PROVIDER=paddle is real, network-capable code
# (apps/api/src/billing/PaddleBillingProvider.ts) but has never been run against a live Paddle
# account — see that file and docs/commercial-decisions.md before enabling it anywhere real money
# could move.
BILLING_PROVIDER=mock
MOCK_BILLING_WEBHOOK_SECRET=mock-billing-webhook-secret-dev-only
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
# A real, dashboard-only credential (Paddle > Developer tools > Authentication — no API endpoint
# exists to list/create it). Distinct from PADDLE_API_KEY (a private server-side secret): this is
# the public, per-environment token Paddle.js needs client-side to open an overlay checkout at
# all. Required before any real Paddle checkout can complete, in sandbox or production.
PADDLE_CLIENT_TOKEN=
TRIAL_PERIOD_DAYS=14
PAST_DUE_GRACE_PERIOD_DAYS=7

# The sole production-safe way to provision a platform_admin account (scripts/
# bootstrapPlatformAdmin.ts) — the production-safe catalog seed never creates one itself. Leave
# both unset in development; set both together before running that script against a real
# deployment, then consider rotating the password immediately after first login.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
