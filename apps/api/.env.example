NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/restaurant_platform
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# File storage (optional for Phase 0 — leave blank until a real bucket exists).
# Works with AWS S3 directly, or any S3-compatible provider (Cloudflare R2, MinIO)
# by setting STORAGE_ENDPOINT.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# Geocoding/address autocomplete (optional — leave GEOCODING_PROVIDER unset and the feature fails
# gracefully with a clear "not configured" error; the app still boots normally either way).
#   GEOCODING_PROVIDER=locationiq   real provider (see docs/delivery-architecture.md) — requires
#                                    GEOCODING_API_KEY from https://locationiq.com
#   GEOCODING_PROVIDER=test         deterministic, offline adapter — no key needed, safe for local
#                                    dev/CI (this is what this repo's own test suites use)
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
GEOCODING_BASE_URL=

# Email (optional — leave EMAIL_PROVIDER unset/"console" and invite/reset emails are logged to the
# server console instead of sent, which is what this repo's own dev/test flows rely on).
#   EMAIL_PROVIDER=smtp   real provider (Nodemailer over SMTP) — requires SMTP_HOST/PORT and
#                         EMAIL_FROM to all be set (getEmailService() throws a clear config error
#                         at first use otherwise, rather than silently falling back to a fake
#                         address or the console provider).
EMAIL_PROVIDER=console
EMAIL_FROM=Tablecloth <no-reply@tablecloth.local>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Payments (PAYMENT_PROVIDER=mock is the safe default — no real money ever moves; see
# apps/api/src/payments/MockPaymentProvider.ts). PAYMENT_PROVIDER=safepay is real, network-capable
# code (apps/api/src/payments/SafepayProvider.ts) but has never been run against a live Safepay
# account — see that file and docs/payment-provider-decision.md before enabling it anywhere real
# money could move.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=mock-payment-webhook-secret-dev-only
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox
