# Phase 85A — the PRODUCTION configuration contract for the API. A template only: every secret is
# deliberately empty. Copy to apps/api/.env.production (gitignored) or load the same keys into the
# host's secret store. docs/production-architecture.md explains each hostname; the API refuses to
# boot when a production-required value below is missing (src/config/env.ts).

NODE_ENV=production
PORT=4000

# --- Hostname contract (docs/production-architecture.md) -------------------------------------
# Marketing                 https://garnishtable.com
# Owner Portal              https://app.garnishtable.com
# Agency Portal             https://agency.garnishtable.com     ┐ same admin build as the
# Platform Admin            https://admin.garnishtable.com      │ Owner Portal, on its own
# POS                       https://pos.garnishtable.com        ┘ hostname
# Customer Storefront       https://order.garnishtable.com
# API / Socket.IO / worker  https://api.garnishtable.com
CLIENT_ORIGIN=https://order.garnishtable.com
ADMIN_ORIGIN=https://app.garnishtable.com
MARKETING_ORIGIN=https://garnishtable.com
API_PUBLIC_ORIGIN=https://api.garnishtable.com
PORTAL_ORIGINS=https://agency.garnishtable.com,https://admin.garnishtable.com,https://pos.garnishtable.com

# The proxies allowed to report the client IP (X-Forwarded-For). REQUIRED. Prefer the edge's
# private address range (e.g. 10.0.0.0/8) — safe even if the API port is reachable directly. A hop
# count (e.g. 1 or 2) is only safe when nothing can reach the API except through those proxies.
TRUST_PROXY=

# --- Data ---------------------------------------------------------------------------------------
# MongoDB Atlas (a replica set — required for transactions). Indexes are NOT auto-built in
# production: run `node dist/scripts/ensureIndexes.js` on every deploy.
MONGO_URI=
# Managed Redis >= 6.2 (production refuses to boot below 5.0). rediss:// for TLS.
# Configure the instance with maxmemory-policy=noeviction (BullMQ) and persistence enabled.
REDIS_URL=

# --- Auth -----------------------------------------------------------------------------------------
# Two different random values, >= 32 chars each (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Object storage (REQUIRED: production throws on the first upload without it) ----------------
# Any S3-compatible bucket. STORAGE_PUBLIC_URL is the public-read base URL for uploaded images.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# --- Transactional email (REQUIRED: SMTP only) ----------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=GarnishTable <no-reply@garnishtable.com>
CONTACT_NOTIFICATION_EMAIL=

# --- Geocoding (needed for delivery orders; pickup works without it) ------------------------------
GEOCODING_PROVIDER=locationiq
GEOCODING_API_KEY=

# --- Restaurant payments ------------------------------------------------------------------------
# mock = cash-only launch. In production the mock provider can never process an online payment,
# its completion route and webhook are disabled, and owners can't switch online payments on.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=production
PAYMENT_ELIGIBILITY_ROUTING=false
CREDENTIAL_ENCRYPTION_KEY=
# "mock" is refused in production.
POS_TERMINAL_PROVIDER=none

# --- Platform billing (Paddle) --------------------------------------------------------------------
# Until Paddle production is configured, leave BILLING_PROVIDER=mock: trials work, paid checkout
# answers "not available yet", and every mock billing route/webhook is disabled in production.
# With BILLING_PROVIDER=paddle, production requires PADDLE_ENV=production, all three credentials,
# and a live (not "test_") client token — or it refuses to boot.
BILLING_PROVIDER=mock
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
TRIAL_PERIOD_DAYS=14
PAST_DUE_GRACE_PERIOD_DAYS=7

# --- Menu import (Anthropic) -----------------------------------------------------------------------
MENU_EXTRACTION_PROVIDER_MODE=live
ANTHROPIC_API_KEY=
# Do not change without updating ClaudeMenuExtractionProvider.ts (forced tool_choice).
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Custom domains --------------------------------------------------------------------------------
# node = real DNS TXT verification (mock is a verification bypass).
DNS_VERIFIER=node
# REQUIRED in production (Phase 86): the hostname restaurants CNAME their domain to (it needs an
# A/AAAA record to the edge), and the private port of the certificate-issuance check Caddy calls.
# With infrastructure/production/docker-compose.yml both — and every *_ORIGIN, PORTAL_ORIGINS and
# TRUST_PROXY above — are set by Compose from infrastructure/production/.env and override this file.
# See docs/custom-domains-operations.md.
CUSTOM_DOMAIN_CNAME_TARGET=domains.garnishtable.com
CUSTOM_DOMAIN_TLS_ASK_PORT=4001

# --- Marketplaces (only after each provider's approval) ------------------------------------------
# In production, mock-mode marketplace webhooks are refused.
MARKETPLACE_PROVIDER_MODE=mock
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SECRET=
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
FOODPANDA_CLIENT_ID=
FOODPANDA_CLIENT_SECRET=
FOODPANDA_CHAIN_ID=
FOODPANDA_WEBHOOK_TOKEN=

# --- One-time platform admin bootstrap (node dist/scripts/bootstrapPlatformAdmin.js) -------------
# Set for that one run, then remove.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
