# Phase 85A — the marketing site's own public origin (production: https://garnishtable.com). Used for
# canonical/Open Graph URLs at runtime, and by the build to rewrite robots.txt and sitemap.xml.
VITE_SITE_URL=
# Cross-origin links: the storefront (live demo at /r/demo-restaurant) and the Owner Portal (signup).
VITE_STOREFRONT_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
# Phase 88 — founder-supplied facts for the legal pages (src/lib/legal.ts). Required for a
# production build (vite.config.ts refuses without them); local dev shows bracketed markers instead.
# Never invent these values.
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_JURISDICTION=
VITE_LEGAL_CONTACT_EMAIL=
VITE_PRIVACY_CONTACT_EMAIL=
VITE_BILLING_CONTACT_EMAIL=

# Publication gate: keep false/blank until every item in docs/legal-readiness-review.md is resolved.
VITE_LEGAL_REVIEW_APPROVED=false
