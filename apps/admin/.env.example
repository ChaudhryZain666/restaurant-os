# Absolute API origin for the Socket.IO client — REST calls go through Vite's /api proxy (see
# vite.config.ts), but the socket connects directly since it isn't proxied.
VITE_API_URL=http://localhost:4000
# The customer storefront app's origin — used to build "Preview storefront"/"View live site"
# links from the restaurant Setup page. Not proxied; opened directly in a new tab.
VITE_STOREFRONT_URL=http://localhost:5173
