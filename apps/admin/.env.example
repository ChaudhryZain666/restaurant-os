# Absolute API origin for the Socket.IO client — REST calls go through Vite's /api proxy (see
# vite.config.ts), but the socket connects directly since it isn't proxied.
VITE_API_URL=http://localhost:4000
# The customer storefront app's origin — used to build "Preview storefront"/"View live site"
# links from the restaurant Setup page. Not proxied; opened directly in a new tab.
VITE_STOREFRONT_URL=http://localhost:5173
# Cross-origin link to the marketing site (contact form, legal pages).
VITE_MARKETING_URL=http://localhost:5175
# Phase 85A — the production hostnames that serve this same build (docs/production-architecture.md).
# On VITE_POS_URL, "/" opens the POS register for users who can operate it. Leave empty locally.
VITE_POS_URL=
VITE_AGENCY_URL=
VITE_PLATFORM_ADMIN_URL=
