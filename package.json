{
  "name": "restaurant-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:marketing": "npm run dev -w apps/marketing",
    "build:packages": "npm run build -w packages/types && npm run build -w packages/validation && npm run build -w packages/utils",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:admin": "npm run build -w apps/admin",
    "build:marketing": "npm run build -w apps/marketing",
    "build": "npm run build:packages && npm run build:api && npm run build:web && npm run build:admin && npm run build:marketing",
    "test:api": "npm run test -w apps/api",
    "test:e2e": "playwright test",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web && npm run lint -w apps/admin && npm run lint -w apps/marketing",
    "seed": "npm run seed -w apps/api",
    "seed:demo": "npm run seed:demo -w apps/api",
    "format": "prettier --write ."
  },
  "prettier": "@restaurant/config/prettier.base.js",
  "devDependencies": {
    "@playwright/test": "^1.48.1",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
